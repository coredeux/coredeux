<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.coredeux</groupId>
        <artifactId>coredeux-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>coredeux-spring-boot-starters</artifactId>
    <packaging>pom</packaging>

    <name>Coredeux Spring Boot Starters</name>
    <description>Spring Boot starter modules for Coredeux database integrations</description>

    <properties>
        <spring.boot.version>3.2.5</spring.boot.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.slf4j</groupId>
                <artifactId>slf4j-api</artifactId>
                <version>2.0.17</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <release>${maven.compiler.release}</release>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <modules>
        <module>coredeux-core-spring-boot-starter</module>
        <module>coredeux-drl-spring-boot-starter</module>
        <module>coredeux-import-spring-boot-starter</module>
        <module>coredeux-export-spring-boot-starter</module>
        <module>coredeux-core-jpa-spring-boot-starter</module>
        <module>coredeux-core-jdbc-spring-boot-starter</module>
        <module>coredeux-core-elasticsearch-spring-boot-starter</module>
        <module>coredeux-core-mongodb-spring-boot-starter</module>
        <module>coredeux-core-redis-spring-boot-starter</module>
    </modules>

</project>
