              }
            ],
            "body": {
              "mode": "raw",
              "raw": "coredeux:\n  entities:\n    - full-class-name: com.coredeux.demo.domain.Customer\n      name: customer\n      identifier: pk\n      storage:\n        data-access-service: customerDataAccess.drl\n      modules:\n        - name: validators\n          enabled: true\n          handlers:\n            - customerEmailValidator\n            - customerValidator.drl\n        - name: hooks\n          enabled: true\n          handlers:\n            - demoLifecycleHook\n            - customerHook.drl\n        - name: audit\n          enabled: true\n          handlers:\n            - demoAuditHandler\n            - customerAudit.drl\n          config:\n            operations:\n              - SAVE\n              - UPDATE\n              - DELETE\n    - full-class-name: com.coredeux.demo.domain.DrlRuleRecord\n      name: DrlRuleRecord\n      identifier: pk\n      storage:\n        data-access-service: postgresCoredeuxJpaDataAccessService"
            },
