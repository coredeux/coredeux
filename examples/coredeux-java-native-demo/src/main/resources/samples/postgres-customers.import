# Plain Java import sample for examples/coredeux-java-native-demo.
# Re-running this file is safe because UPSERT resolves customers by the unique id column.
OPTIONS(passes=1,failFast=false,validateOnly=false)

UPSERT com.coredeux.demo.domain.Customer | pk(unique=true) | name | email | active | status
                                                        | 1              | Imported Ada Lovelace | imported.ada@example.test | true | ACTIVE
                                                        | 2              | Imported Grace Hopper | imported.grace@example.test | true | ACTIVE
                                                        | 3              |      | imported.blank@example.test | true | ACTIVE
