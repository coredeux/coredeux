<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_1.xsd"
             version="3.1">
    <persistence-unit name="coredeux-postgres-native" transaction-type="RESOURCE_LOCAL">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>
        <class>com.coredeux.demo.domain.Customer</class>
        <class>com.coredeux.demo.domain.Product</class>
        <class>com.coredeux.demo.domain.Role</class>
        <class>com.coredeux.demo.domain.Address</class>
        <class>com.coredeux.demo.domain.CustomerProfile</class>
        <class>com.coredeux.demo.domain.CustomerOrder</class>
        <class>com.coredeux.demo.domain.OrderItem</class>
        <class>com.coredeux.demo.export.ExportStorageRecord</class>
        <class>com.coredeux.examples.nativejava.drl.DrlRuleRecord</class>
        <exclude-unlisted-classes>true</exclude-unlisted-classes>
        <properties>
            <property name="jakarta.persistence.jdbc.driver" value="org.postgresql.Driver"/>
            <property name="jakarta.persistence.jdbc.url" value="jdbc:postgresql://localhost:5432/coredeux"/>
            <property name="jakarta.persistence.jdbc.user" value="postgres"/>
            <property name="jakarta.persistence.jdbc.password" value="root"/>
            <property name="hibernate.dialect" value="org.hibernate.dialect.PostgreSQLDialect"/>
            <property name="hibernate.hbm2ddl.auto" value="update"/>
            <property name="hibernate.show_sql" value="false"/>
            <property name="hibernate.format_sql" value="false"/>
        </properties>
    </persistence-unit>
</persistence>
